# Kensigline — one env file for the API and the Vite SPA.
# Copy this file to `.env` in the REPOSITORY ROOT (next to package.json).
# Backend and `npm run dev` both read only that file (not backend/.env or frontend/.env).

PORT=3001
# Where the browser should call the API (health, Bosha, bars, …)
API_BASE_URL=http://localhost:3001

# Postgres (local or Supabase pooler URL from Project Settings → Database)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=

# Supabase — same project URL for DB host, Auth JWKS, and the SPA client
# Project Settings → API: Project URL + anon (publishable) key
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional auth overrides (see https://supabase.com/docs/guides/auth/jwts)
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_SECRET=

# Force TLS for non-Supabase Postgres hosts. Omit for local.
# DATABASE_SSL=1
# DATABASE_SSL_REJECT_UNAUTHORIZED=0

SEC_USER_AGENT=Kensigline dev you@domain.com
SEC_MIN_INTERVAL_MS=1500

INSIDER_FEED_PAGES_PER_MIN=7
INSIDER_FEED_PAGES_PER_MIN_CATCHUP=12
INSIDER_ENQUEUE_INTERVAL_MS=60000
INSIDER_PARSE_POLL_MS=5000
INSIDER_PARSE_THROTTLE_MS=750
INSIDER_PARSE_CONCURRENCY=3

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

POLYGON_API_KEY=
POLYGON_MIN_INTERVAL_MS=12500
YAHOO_MIN_INTERVAL_MS=500

OUTCOMES_RECOMPUTE_INTERVAL_MS=21600000
OUTCOMES_RECOMPUTE_ON_START=1
OUTCOMES_LOOKBACK_DAYS=365
OUTCOMES_MAX_TICKERS=500
OUTCOMES_ENABLE_POLITICIANS=1
OUTCOMES_ENABLE_BOSHA=1

PHARMA_ENQUEUE_INTERVAL_MS=60000
PHARMA_FEED_PAGES_PER_MIN=3
PHARMA_FEED_PAGES_PER_MIN_CATCHUP=6
PHARMA_CATCHUP=0
PHARMA_PARSE_POLL_MS=6000
PHARMA_PARSE_THROTTLE_MS=1200
PHARMA_PARSE_CONCURRENCY=1

# (Optional) Ollama / local models:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
