# Kensigline — one env file for the API and the Vite SPA.
# Copy this file to `.env` in the REPOSITORY ROOT (next to package.json).
# Backend and `npm run dev` both read only that file (not backend/.env or frontend/.env).

PORT=3001
# Where the browser should call the API (health, Bosha, bars, …)
API_BASE_URL=http://localhost:3001

# Private content API (Hermes / distribution scripts) — same key as production
# Base URL: https://api.mercerline.com  (or https://mercerline.com — proxied to api)
# GET /api/internal/content/today | /events | /event/:id
# Authorization: Bearer <key>  or  X-Content-Api-Key: <key>
CONTENT_API_KEY=

# Postgres (local or Supabase pooler URL from Project Settings → Database)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=
# Separate pools so ingest workers cannot starve interactive API / sign-in.
# DATABASE_POOL_MAX=8
# DATABASE_WORKER_POOL_MAX=8
# Cap concurrent worker SQL only (HTTP/SEC can run wider via PARSE_CONCURRENCY).
# WORKER_QUERY_CONCURRENCY=8
# Historical drain (waitlist): DATABASE_WORKER_POOL_MAX=12 WORKER_QUERY_CONCURRENCY=8
# + PARSE_CONCURRENCY=8–12 per pipeline; dial back for daily-only after drain.
# WORKERS_ENABLED=1
# Set WORKERS_ENABLED=0 on the API process and run `npm run start:workers` separately.
# DATABASE_CONNECT_TIMEOUT_MS=8000
# Bars refresh: slower defaults free pooler for dossier opens.
# BARS_REFRESH_ENABLED=0
# BARS_REFRESH_INTERVAL_MS=180000
# BARS_REFRESH_BATCH=2
# BILLING_ACCESS_CACHE_TTL_MS=60000
# DOSSIER_CACHE_DEBOUNCE_MS=8000

# Supabase — same project URL for DB host, Auth JWKS, and the SPA client
# Project Settings → API: Project URL + anon (publishable) key
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Sign-in page: enable Google under Authentication → Providers (add OAuth client ID/secret)
# Redirect URL: {FRONTEND_URL}/ and http://localhost:5173/
# Project Settings → API: service_role key (server only — provisions users after Whop checkout)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (subscriptions) — key mode must match price IDs (test vs live)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=
# STRIPE_PRICE_ID_MONTHLY_FOUNDERS=
# STRIPE_PRICE_ID_YEARLY_FOUNDERS=

# Whop (subscriptions + checkout + attribution)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
WHOP_PLAN_ID_MONTHLY=
WHOP_PLAN_ID_YEARLY=
# WHOP_PLAN_ID_MONTHLY_FOUNDERS=
# WHOP_PLAN_ID_YEARLY_FOUNDERS=
# WHOP_PORTAL_URL=https://whop.com/hub/memberships
# WHOP_SANDBOX=0
# VITE_WHOP_COMPANY_ID=biz_xxxxxxxxxxxxx
# VITE_WHOP_ENV=production

# Founders kill switch — FOUNDERS_PRICING=1 uses founders prices for new checkouts.
# Flip to 0 and restart the API (no Cloudflare rebuild). Existing subs keep their plan.
# FOUNDERS_PRICING=1
# Waitlist lock — hides subscribe/sign-in, blocks terminal until Whop is ready.
WAITLIST_MODE=1
# FOUNDERS_PRICING=1
VITE_WAITLIST_MODE=1
# Where users return after checkout / billing portal (SPA origin)
FRONTEND_URL=http://localhost:5173

# Subscription gate — backend always respects BILLING_GATE_ENABLED (default on).
# BILLING_GATE_ENABLED=0
#
# Frontend paywall (vite build): set in .env.production (1) vs .env.development (0).
# VITE_BILLING_GATE=0
#
# Forever dev access on live: Supabase Dashboard → Authentication → Users → your user
# → Raw App Meta Data: { "billing_exempt": true }  (then sign out/in)

# Optional auth overrides (see https://supabase.com/docs/guides/auth/jwts)
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_SECRET=

# Supabase pooler on macOS often needs this if you see "self-signed certificate in certificate chain":
DATABASE_SSL_REJECT_UNAUTHORIZED=0
# Force TLS for non-Supabase Postgres hosts. Omit for local.
# DATABASE_SSL=1

SEC_USER_AGENT=Kensigline dev you@domain.com
# Default in code is 120ms / 8 rps (SEC fair-access ~10/s). 1500ms = ~57k/day hard ceiling.
SEC_MIN_INTERVAL_MS=100
# Default 9 req/s process-wide (headroom under SEC 10/s). Even-paced via sec-rate-gate.
SEC_MAX_RPS=9
# Max concurrent in-flight SEC HTTP requests process-wide (parse + enqueue share one pool).
SEC_MAX_IN_FLIGHT=8
# Queue retry: 503/network=1s base; 429/bot uses SEC_RATE_LIMIT_COOLDOWN_MS (10m default).
# QUEUE_FAST_RETRY_BASE_SEC=1
# QUEUE_429_MAX_ATTEMPTS=6
# QUEUE_TRANSIENT_MAX_ATTEMPTS=12

INSIDER_FEED_PAGES_PER_MIN=7
INSIDER_FEED_PAGES_PER_MIN_CATCHUP=12
INSIDER_ENQUEUE_INTERVAL_MS=60000
INSIDER_PARSE_POLL_MS=500
INSIDER_PARSE_THROTTLE_MS=0
INSIDER_PARSE_CONCURRENCY=8

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Or: DEEPSEEK_API_KEY=
# LLM_PROVIDER=openai + LLM_BASE_URL=https://api.openai.com/v1 also works (same client).
LLM_LOG_USAGE=1

# LLM input character budgets (after compaction). Defaults are tuned for cost.
# LLM_BUDGET_SEC=24000
# LLM_BUDGET_RESEARCH_EXTRACT=24000
# LLM_BUDGET_PRESS=16000
# LLM_BUDGET_TRANSCRIPT=22000
# LLM_BUDGET_GOV=14000
# LLM_BUDGET_13F_FULL=30000
# LLM_BUDGET_13F_COVER=4000
# LLM_BUDGET_HOUSE_PTR=40000
# Research SEC backfill forms (live feed still uses RESEARCH_SEC_FORMS)
# RESEARCH_BACKFILL_SEC_FORMS=8-K,10-Q,10-K
POLYGON_MIN_INTERVAL_MS=12500
YAHOO_MIN_INTERVAL_MS=500

# Discover macro calendar uses Yahoo Finance (no key). Reuses YAHOO_MIN_INTERVAL_MS.
# MACRO_CALENDAR_CACHE_MS=3600000
# MACRO_CALENDAR_MAX_EVENTS_PER_DAY=12
# MACRO_CALENDAR_YAHOO_MAX_PAGES=4
# DISCOVER_TIMELINE_CACHE_MS=45000

OUTCOMES_RECOMPUTE_INTERVAL_MS=21600000
# Keep off in production — startup recompute starves the API DB pool / can OOM the box.
OUTCOMES_RECOMPUTE_ON_START=0
OUTCOMES_LOOKBACK_DAYS=365
OUTCOMES_MAX_TICKERS=500
OUTCOMES_ENABLE_POLITICIANS=1
OUTCOMES_ENABLE_BOSHA=1

PHARMA_ENQUEUE_INTERVAL_MS=60000
PHARMA_FEED_PAGES_PER_MIN=3
PHARMA_FEED_PAGES_PER_MIN_CATCHUP=6
PHARMA_CATCHUP=0
PHARMA_PARSE_POLL_MS=6000
PHARMA_PARSE_THROTTLE_MS=1200
PHARMA_PARSE_CONCURRENCY=1

# Idle historical backfill (runs when a pipeline's parse queue is empty).
# Set BACKFILL_ENABLED=0 to disable. Cursors stored in ingest_cursors table.
#
# ── INGEST_MODE (master switch) ─────────────────────────────────────────────
# backfill — initial 365d parallel walk (default when unset)
# catchup  — ~30d sequential re-run; live never auto-on
# drain    — historical done, max parse, chew queue (current prod phase)
# live     — steady state; capped parse + live enqueue (flip manually)
# INGEST_MODE=drain
#
# Never auto-enable live during backfill/catchup/drain (always keep 0 there):
BACKFILL_ENABLED=1
BACKFILL_LIVE_ENQUEUE=0
# parallel = multi-pipeline (initial 365d). sequential = catch-up re-run.
BACKFILL_SCHEDULE=parallel
BACKFILL_SEQUENCE=research,politicians,insider,institutions
# Block live until queue below low water — only matters when INGEST_MODE=live.
ENQUEUE_GATE_LIVE=1
LIVE_ENQUEUE_ENABLED=0
#
# ── Preset: DRAIN (chew backlog after 365d backfill) ─────────────────────────
# INGEST_MODE=drain
# BACKFILL_LIVE_ENQUEUE=0
# INSTITUTIONS_PARSE_CONCURRENCY=10
# DRAIN_PARSE_SLOT_MAX=20
# WORKER_QUERY_CONCURRENCY=14
# DATABASE_WORKER_POOL_MAX=14
# DATABASE_POOL_MAX=4
#
# ── Preset: CATCHUP (~30d missed filings, run once) ────────────────────────
# INGEST_MODE=catchup
# BACKFILL_MAX_AGE_DAYS=30
# BACKFILL_SCHEDULE=sequential
# BACKFILL_LIVE_ENQUEUE=0
# CATCHUP_PARSE_SLOT_MAX=16
# BACKFILL_QUEUE_LOW_WATER=120
# BACKFILL_QUEUE_HIGH_WATER=900
# Reset ingest_cursors (sec_daily + historical_done) for each pipeline, restart.
#
# ── Preset: LIVE (steady state — protect API pool) ─────────────────────────
# INGEST_MODE=live
# LIVE_ENQUEUE_ENABLED=1
# WAITLIST_MODE=0
# FOUNDERS_PRICING=1
# BACKFILL_LIVE_ENQUEUE=0
# BACKFILL_ENABLED=1
# LIVE_GAP_FILL_ENABLED=1
# LIVE_GAP_FILL_DAYS=14
# ENQUEUE_GATE_LIVE=0
# LIVE_PARSE_SLOT_MAX=12
# LIVE_WORKER_QUERY_CONCURRENCY=11
# LIVE_DATABASE_WORKER_POOL_MAX=11
# DATABASE_SESSION_POOL_MAX=15
# DATABASE_SESSION_POOL_HEADROOM=4
# LIVE_DATABASE_POOL_MIN=4
# DATABASE_POOL_MAX=4
# INSTITUTIONS_PARSE_CONCURRENCY=4
# INSIDER_PARSE_CONCURRENCY=4
# RESEARCH_PARSE_CONCURRENCY=3
# POLITICIANS_PARSE_CONCURRENCY=2
#
# How far back to walk SEC daily index + PTR windows (days). Hard-capped at 365 (1 year) in code.
BACKFILL_MAX_AGE_DAYS=365
BACKFILL_MIN_DATE=2012-01-01
BACKFILL_SEC_LIMIT_PER_DAY=0
# WORKER_DB_SESSION_POOLER=1  # workers use pooler :5432 (session) — fixes ECHECKOUTTIMEOUT on 13F drain
# DATABASE_SESSION_POOL_MAX=15  # Supabase session pooler cap (shared budget for worker lane)
# DATABASE_SESSION_POOL_HEADROOM=4  # db.ts clamps worker pool to max - headroom
# WORKER_DB_DIRECT=1  # needs Supabase IPv4 add-on; IPv6-only hosts will hang
# DATABASE_WORKER_URL=  # optional explicit worker Postgres URL
# Optional purge of stored rows older than 1y — leave OFF (we cap ingest, not delete history).
RETENTION_ENABLED=0
RETENTION_PURGE_ON_START=0
# Optional: keep research Analyse driver docs this many days past 1y if purge is enabled.
RETENTION_ANALYSE_EXTRA_DAYS=0
# Chart bars lookback (days) — capped at 730 for refresh fetches.
BARS_REFRESH_LOOKBACK_DAYS=730
# Optional override — default backfills all RESEARCH_SEC_FORMS as template-only rows for the paper panel.
# RESEARCH_BACKFILL_SEC_FORMS=8-K,10-Q,10-K,6-K,20-F,S-1,S-3,S-4,DEF 14A,424B5,SC 13D,SC 13G
# Research structured LLM (Analyse business_drivers from 10-Q/10-K/transcripts).
# 1 = allow last-resort LLM after template/reuse/skip checks (live priority only unless backfill LLM on).
RESEARCH_STRUCTURED_LLM=1
# Historical backfill LLM — leave 0 (expensive). Live earnings still use RESEARCH_STRUCTURED_LLM.
BACKFILL_LLM_ENABLED=0
# Live SEC forms that get structured LLM when RESEARCH_STRUCTURED_LLM=1 — comma-separated.
STRUCTURED_LLM_SEC_FORMS=10-Q,10-K
# 13F: LLM when deterministic CUSIP/name resolve maps zero holdings.
INSTITUTIONS_LLM_FALLBACK=1
# Live Senate PTR lookback (days); backfill uses BACKFILL_SENATE_WINDOW_DAYS steps within BACKFILL_MAX_AGE_DAYS.
POLITICIANS_SENATE_LOOKBACK_DAYS=90
# Live OGE Form 278-T lookback (days); backfill walks PAS API pages via ingest_cursors oge_api_start.
POLITICIANS_OGE_LOOKBACK_DAYS=90
BACKFILL_SENATE_WINDOW_DAYS=60
BACKFILL_POLITICIANS_MAX_PER_BATCH=120
# Per-pipeline throttle: INSIDER_BACKFILL_INTERVAL_MS, RESEARCH_BACKFILL_INTERVAL_MS, etc.

# Idea scoring threshold (strict “best-of-the-best” highlight + digests)
IDEA_SCORE_BEST=75
# Days after event_at before idea_best highlight expires on Investigate rows (default 4)
IDEA_BEST_DECAY_DAYS=4
# Ticker rollup: carry investigate best signal to Research / other tabs (days)
IDEA_ROLLUP_DECAY_DAYS=14

# Ticker + actor watchlist — combined max slots per user (default: 20)
WATCHLIST_MAX_TICKERS=20
ALERT_TICKER_LOOKBACK_MINUTES=35

# Waitlist signup pings (no DB). Uses FormSubmit → WAITLIST_NOTIFY_TO (your Gmail).
# First submission emails you an activation link — click once, then joins land in inbox.
# WAITLIST_NOTIFY_TO=you@gmail.com

# ClinicalTrials.gov API v2 (public; no key). Used for clinical context clock + programs.
CLINICAL_TRIALS_CACHE_MS=1800000
CLINICAL_TRIALS_PAGE_SIZE=40
CLINICAL_TRIALS_MIN_INTERVAL_MS=250

# (Optional) Ollama / local models:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
