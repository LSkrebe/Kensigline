# Kensigline — one env file for the API and the Vite SPA.
# Copy this file to `.env` in the REPOSITORY ROOT (next to package.json).
# Backend and `npm run dev` both read only that file (not backend/.env or frontend/.env).

PORT=3001
# Where the browser should call the API (health, Bosha, bars, …)
API_BASE_URL=http://localhost:3001

# Postgres (local or Supabase pooler URL from Project Settings → Database)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=
# Separate pools so ingest workers cannot starve interactive API / sign-in.
# DATABASE_POOL_MAX=4
# DATABASE_WORKER_POOL_MAX=2
# Only one heavy worker DB job at a time across all pipelines (keeps Auth healthy).
# WORKER_DB_CONCURRENCY=1
# DATABASE_CONNECT_TIMEOUT_MS=8000
# BILLING_ACCESS_CACHE_TTL_MS=60000

# Supabase — same project URL for DB host, Auth JWKS, and the SPA client
# Project Settings → API: Project URL + anon (publishable) key
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe (subscriptions) — key mode must match price IDs (test vs live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Founders kill switch — FOUNDERS_PRICING=1 uses founders prices for new checkouts.
# Flip to 0 and restart the API (no Cloudflare rebuild). Existing founders subs keep their Stripe prices.
# FOUNDERS_PRICING=1
# STRIPE_PRICE_ID_MONTHLY_FOUNDERS=
# STRIPE_PRICE_ID_YEARLY_FOUNDERS=
# Local live webhooks: stripe listen --live --forward-to localhost:3001/api/billing/webhook
# Where users return after checkout / billing portal (SPA origin)
FRONTEND_URL=http://localhost:5173

# Subscription gate — set to 0 to bypass billing locally (API + SPA).
# BILLING_GATE_ENABLED=0
# VITE_BILLING_GATE=0
#
# Forever dev access on live: Supabase Dashboard → Authentication → Users → your user
# → Raw App Meta Data: { "billing_exempt": true }  (then sign out/in)

# Optional auth overrides (see https://supabase.com/docs/guides/auth/jwts)
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_SECRET=

# Supabase pooler on macOS often needs this if you see "self-signed certificate in certificate chain":
DATABASE_SSL_REJECT_UNAUTHORIZED=0
# Force TLS for non-Supabase Postgres hosts. Omit for local.
# DATABASE_SSL=1

SEC_USER_AGENT=Kensigline dev you@domain.com
SEC_MIN_INTERVAL_MS=1500

INSIDER_FEED_PAGES_PER_MIN=7
INSIDER_FEED_PAGES_PER_MIN_CATCHUP=12
INSIDER_ENQUEUE_INTERVAL_MS=60000
INSIDER_PARSE_POLL_MS=5000
INSIDER_PARSE_THROTTLE_MS=750
INSIDER_PARSE_CONCURRENCY=3

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Or: DEEPSEEK_API_KEY=
# LLM_PROVIDER=openai + LLM_BASE_URL=https://api.openai.com/v1 also works (same client).
LLM_LOG_USAGE=1

# LLM input character budgets (after compaction). Defaults are tuned for cost.
# LLM_BUDGET_SEC=24000
# LLM_BUDGET_RESEARCH_EXTRACT=24000
# LLM_BUDGET_PRESS=16000
# LLM_BUDGET_TRANSCRIPT=22000
# LLM_BUDGET_GOV=14000
# LLM_BUDGET_13F_FULL=30000
# LLM_BUDGET_13F_COVER=4000
# LLM_BUDGET_HOUSE_PTR=40000
# Research SEC backfill forms (live feed still uses RESEARCH_SEC_FORMS)
# RESEARCH_BACKFILL_SEC_FORMS=8-K,10-Q,10-K
POLYGON_MIN_INTERVAL_MS=12500
YAHOO_MIN_INTERVAL_MS=500

# Discover macro calendar uses Yahoo Finance (no key). Reuses YAHOO_MIN_INTERVAL_MS.
# MACRO_CALENDAR_CACHE_MS=3600000
# MACRO_CALENDAR_MAX_EVENTS_PER_DAY=12
# MACRO_CALENDAR_YAHOO_MAX_PAGES=4
# DISCOVER_TIMELINE_CACHE_MS=45000

OUTCOMES_RECOMPUTE_INTERVAL_MS=21600000
# Keep off in production — startup recompute starves the API DB pool / can OOM the box.
OUTCOMES_RECOMPUTE_ON_START=0
OUTCOMES_LOOKBACK_DAYS=365
OUTCOMES_MAX_TICKERS=500
OUTCOMES_ENABLE_POLITICIANS=1
OUTCOMES_ENABLE_BOSHA=1

PHARMA_ENQUEUE_INTERVAL_MS=60000
PHARMA_FEED_PAGES_PER_MIN=3
PHARMA_FEED_PAGES_PER_MIN_CATCHUP=6
PHARMA_CATCHUP=0
PHARMA_PARSE_POLL_MS=6000
PHARMA_PARSE_THROTTLE_MS=1200
PHARMA_PARSE_CONCURRENCY=1

# Idle historical backfill (runs when a pipeline's parse queue is empty).
# Set BACKFILL_ENABLED=0 to disable. Cursors stored in ingest_cursors table.
BACKFILL_ENABLED=1
# How far back to walk SEC daily index + PTR windows (days). Hard-capped at 730 (2 years) in code.
BACKFILL_MAX_AGE_DAYS=730
BACKFILL_MIN_DATE=2012-01-01
BACKFILL_SEC_LIMIT_PER_DAY=300
# Optional purge of stored rows older than 2y — leave OFF (we cap ingest, not delete history).
RETENTION_ENABLED=0
RETENTION_PURGE_ON_START=0
# Optional: keep research Analyse driver docs this many days past 2y if purge is enabled.
RETENTION_ANALYSE_EXTRA_DAYS=0
# Chart bars lookback (days) — capped at 730 for refresh fetches.
BARS_REFRESH_LOOKBACK_DAYS=730
# Optional override — default backfills all RESEARCH_SEC_FORMS as template-only rows for the paper panel.
# RESEARCH_BACKFILL_SEC_FORMS=8-K,10-Q,10-K,6-K,20-F,S-1,S-3,S-4,DEF 14A,424B5,SC 13D,SC 13G
# Research structured LLM (Analyse business_drivers from 10-Q/10-K/transcripts).
# 1 = allow last-resort LLM after template/reuse/skip checks (live priority only unless backfill LLM on).
RESEARCH_STRUCTURED_LLM=1
# Historical backfill LLM — leave 0 (expensive). Live earnings still use RESEARCH_STRUCTURED_LLM.
BACKFILL_LLM_ENABLED=0
# Live SEC forms that get structured LLM when RESEARCH_STRUCTURED_LLM=1 — comma-separated.
STRUCTURED_LLM_SEC_FORMS=10-Q,10-K
# 13F: LLM when deterministic CUSIP/name resolve maps zero holdings.
INSTITUTIONS_LLM_FALLBACK=1
# Live Senate PTR lookback (days); backfill uses BACKFILL_SENATE_WINDOW_DAYS steps within BACKFILL_MAX_AGE_DAYS.
POLITICIANS_SENATE_LOOKBACK_DAYS=90
# Live OGE Form 278-T lookback (days); backfill walks PAS API pages via ingest_cursors oge_api_start.
POLITICIANS_OGE_LOOKBACK_DAYS=90
BACKFILL_SENATE_WINDOW_DAYS=60
BACKFILL_POLITICIANS_MAX_PER_BATCH=120
# Per-pipeline throttle: INSIDER_BACKFILL_INTERVAL_MS, RESEARCH_BACKFILL_INTERVAL_MS, etc.

# Idea scoring threshold (strict “best-of-the-best” highlight + digests)
IDEA_SCORE_BEST=75
# Days after event_at before idea_best highlight expires on Investigate rows (default 4)
IDEA_BEST_DECAY_DAYS=4
# Ticker rollup: carry investigate best signal to Research / other tabs (days)
IDEA_ROLLUP_DECAY_DAYS=14

# Ticker + actor watchlist — combined max slots per user (default: 20)
WATCHLIST_MAX_TICKERS=20
ALERT_TICKER_LOOKBACK_MINUTES=35

# Watchlist context emails — batched, max emails per user per day (digest excluded)
ALERT_CONTEXT_POLL_MS=1800000
ALERT_CONTEXT_LOOKBACK_MINUTES=35
ALERT_CONTEXT_EMAILS_PER_DAY=20

# Email idea digests (Brevo — 300 emails/day free). Set BREVO_API_KEY to send; ALERTS_ENABLED=0 to disable worker.
# Two digests per day: morning_hour + evening_hour in alert_preferences (defaults 8 and 18).
ALERTS_ENABLED=1
ALERTS_DIGEST_POLL_MS=900000
ALERTS_POLL_MS=900000
BREVO_API_KEY=
ALERT_EMAIL_FROM=Kensigline <alerts@yourdomain.com>
# Optional override for “Talk to the founders” inbox (defaults to ALERT_EMAIL_FROM address).
# SUPPORT_INBOX=founders@yourdomain.com

# ClinicalTrials.gov API v2 (public; no key). Used for clinical context clock + programs.
CLINICAL_TRIALS_CACHE_MS=1800000
CLINICAL_TRIALS_PAGE_SIZE=40
CLINICAL_TRIALS_MIN_INTERVAL_MS=250

# (Optional) Ollama / local models:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
