PORT=3001

# Postgres: local dev (example — keep your own commented copy in .env when switching)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Supabase: paste the URI from Project Settings → Database (Direct or pooler).
# Node enables TLS for *.supabase.co and *.pooler.supabase.com (and *.supabase.com).
# Optional: append ?sslmode=require for CLI tools (psql).
DATABASE_URL=

# Force TLS for non-Supabase hosts (e.g. managed Postgres). Omit for local.
# DATABASE_SSL=1

# If Node errors with "self-signed certificate in chain" (proxy / corp SSL inspection),
# set to 0 only for local debugging — prefer fixing CA bundle or NODE_EXTRA_CA_CERTS.
# DATABASE_SSL_REJECT_UNAUTHORIZED=0

# Required for SEC EDGAR requests.
SEC_USER_AGENT=Kensigline dev you@domain.com
# Throttle SEC requests (ms) to reduce blocking.
SEC_MIN_INTERVAL_MS=1500

# Insider worker (runs by default)
# Poll SEC "current filings" feed for Form 4s (all issuers).
INSIDER_FEED_PAGES_PER_MIN=7
INSIDER_FEED_PAGES_PER_MIN_CATCHUP=12
INSIDER_ENQUEUE_INTERVAL_MS=60000
INSIDER_PARSE_POLL_MS=5000
INSIDER_PARSE_THROTTLE_MS=750
INSIDER_PARSE_CONCURRENCY=3

# LLM integration (Qwen 7B)
# Use OpenAI (or any OpenAI-compatible server).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Accepts: LLM_API_KEY or OPENAI_API_KEY or OPENAPI_SECRET_KEY
LLM_API_KEY=

# Market data (daily close bars)
POLYGON_API_KEY=
POLYGON_MIN_INTERVAL_MS=12500
YAHOO_MIN_INTERVAL_MS=500

# Outcomes (Main tab trend charts: mean forward returns after signal days; snapshots in `outcomes`)
OUTCOMES_RECOMPUTE_INTERVAL_MS=21600000
# Run a full recompute once at process start so charts have data without waiting for the first interval (set 0 to disable).
OUTCOMES_RECOMPUTE_ON_START=1
OUTCOMES_LOOKBACK_DAYS=365
OUTCOMES_MAX_TICKERS=500
OUTCOMES_ENABLE_POLITICIANS=1
OUTCOMES_ENABLE_BOSHA=1

# Pharma worker (SEC filings -> trial events)
PHARMA_ENQUEUE_INTERVAL_MS=60000
PHARMA_FEED_PAGES_PER_MIN=3
PHARMA_FEED_PAGES_PER_MIN_CATCHUP=6
PHARMA_CATCHUP=0
PHARMA_PARSE_POLL_MS=6000
PHARMA_PARSE_THROTTLE_MS=1200
PHARMA_PARSE_CONCURRENCY=1

# (Optional) Ollama / local models:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
